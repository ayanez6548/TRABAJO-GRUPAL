<CascadingAuthenticationState>
    <Router AppAssembly="typeof(App).Assembly" AdditionalAssemblies="new[] { typeof(NorthWind.Sales.Frontend.Views.Pages.CreateOrderPage).Assembly, typeof(NorthWind.Membership.Frontend.RazorViews.Pages.UserLoginPage).Assembly }">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainLayout)">
                <NotAuthorized><RedirectToLogin /></NotAuthorized>
                <Authorizing><p>Verificando tu sesión…</p></Authorizing>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound><LayoutView Layout="typeof(MainLayout)"><h1>Página no encontrada</h1><a href="/">Volver al inicio</a></LayoutView></NotFound>
    </Router>
</CascadingAuthenticationState>

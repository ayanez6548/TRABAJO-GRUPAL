FROM debian:13-slim AS sdk
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl libfontconfig1 fonts-dejavu-core \
    && curl -fsSL https://packages.microsoft.com/config/debian/13/packages-microsoft-prod.deb -o /tmp/microsoft.deb \
    && dpkg -i /tmp/microsoft.deb && rm /tmp/microsoft.deb \
    && apt-get update && apt-get install -y --no-install-recommends dotnet-sdk-10.0 \
    && rm -rf /var/lib/apt/lists/*
ENV DOTNET_PROCESSOR_COUNT=2 DOTNET_CLI_WORKLOAD_UPDATE_NOTIFY_DISABLE=true
WORKDIR /workspace
COPY . .

FROM sdk AS frontend
RUN dotnet restore "src/4. Frameworks And Drivers/UIs/NorthWind.Sales.BlazorClient" --disable-parallel \
    && dotnet build "src/4. Frameworks And Drivers/UIs/NorthWind.Sales.BlazorClient" -c Release --no-restore -m:1
ENV ASPNETCORE_ENVIRONMENT=Development ASPNETCORE_URLS=http://0.0.0.0:5200
EXPOSE 5200
ENTRYPOINT ["dotnet", "run", "--project", "src/4. Frameworks And Drivers/UIs/NorthWind.Sales.BlazorClient", "-c", "Release", "--no-build", "--no-restore", "--no-launch-profile"]

FROM sdk AS backend
RUN dotnet restore "src/4. Frameworks And Drivers/UI/NorthWind.Sales.WebApi" --disable-parallel \
    && dotnet build "src/4. Frameworks And Drivers/UI/NorthWind.Sales.WebApi" -c Release --no-restore -m:1
ENV ASPNETCORE_ENVIRONMENT=Development ASPNETCORE_URLS=http://0.0.0.0:5100 DevelopmentTools__MailtrapUrl=""
EXPOSE 5100
ENTRYPOINT ["dotnet", "run", "--project", "src/4. Frameworks And Drivers/UI/NorthWind.Sales.WebApi", "-c", "Release", "--no-build", "--no-restore", "--no-launch-profile"]

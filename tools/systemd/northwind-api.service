[Unit]
Description=NorthWind published backend (.NET 10)
Requires=docker.service
Wants=network-online.target
After=network-online.target docker.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=alex
Group=alex
WorkingDirectory=/home/alex/NorthWind/publish/backend
EnvironmentFile=/home/alex/NorthWind/.env.debian
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_ENVIRONMENT=Production
Environment=DOTNET_NOLOGO=1
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=HOME=/var/lib/northwind-api
Environment=DOTNET_CLI_HOME=/var/lib/northwind-api
ExecStartPre=/usr/bin/python3 /home/alex/NorthWind/tools/systemd/wait-database.py
ExecStart=/usr/bin/dotnet /home/alex/NorthWind/publish/backend/NorthWind.Sales.WebApi.dll --urls=http://127.0.0.1:5100 --Database:ApplyMigrations=false --Swagger:Enabled=true
Restart=on-failure
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=45
KillSignal=SIGTERM
SyslogIdentifier=northwind-api
StandardOutput=journal
StandardError=journal
UMask=0077
StateDirectory=northwind-api
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/home/alex/NorthWind/publish/backend/App_Data

[Install]
WantedBy=multi-user.target
